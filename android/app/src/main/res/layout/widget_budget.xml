<?xml version="1.0" encoding="utf-8"?>
<!-- Budget-Widget (groß). Alle IDs gibt es in beiden Größen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wurzel" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_hg" android:padding="16dp">

    <LinearLayout android:id="@+id/kopf" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/symbol_hg">
            <ImageView android:id="@+id/symbol" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="8dp" android:src="@drawable/ic_wagen" android:contentDescription="@null"/>
            <TextView android:id="@+id/symbolEmoji" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:textSize="17sp" android:includeFontPadding="false" android:visibility="gone"/>
        </FrameLayout>
        <TextView android:id="@+id/pfeilLinks" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:text="‹" android:textColor="#EEF2F0" android:textSize="22sp" android:includeFontPadding="false" android:contentDescription="Vorherige Kategorie" android:visibility="gone"/>
        <TextView android:id="@+id/name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginLeft="10dp" android:text="Lebensmittel" android:textColor="#EEF2F0" android:textSize="17sp" android:fontFamily="@font/barlow_semibold" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/pfeilRechts" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:text="›" android:textColor="#EEF2F0" android:textSize="22sp" android:includeFontPadding="false" android:contentDescription="Nächste Kategorie" android:visibility="gone"/>
        <TextView android:id="@+id/budget" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Budget 300 €" android:textColor="#B7C1BE" android:textSize="13sp" android:fontFamily="@font/barlow_regular" android:visibility="visible"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom" android:layout_marginTop="10dp">
        <LinearLayout android:id="@+id/betragbereich" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AUSGEGEBEN IM NOVEMBER" android:textColor="#B7C1BE" android:textSize="12sp" android:letterSpacing="0.04" android:fontFamily="@font/barlow_regular" android:visibility="visible"/>
            <TextView android:id="@+id/betrag" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="− 158 €" android:textColor="#EF9A8F" android:textSize="40sp" android:fontFamily="@font/barlow_light" android:includeFontPadding="false"/>
        </LinearLayout>
        <TextView android:id="@+id/rest" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingBottom="4dp" android:text="noch 142 €" android:textColor="#B7C1BE" android:textSize="15sp" android:fontFamily="@font/barlow_regular" android:visibility="visible"/>
    </LinearLayout>
    <TextView android:id="@+id/info" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="noch 142 € von 300 €" android:textColor="#B7C1BE" android:textSize="13sp" android:fontFamily="@font/barlow_regular" android:maxLines="2" android:visibility="gone"/>

    <ImageView android:id="@+id/balken" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="10dp" android:scaleType="fitXY" android:contentDescription="@null"/>

    <TextView android:id="@+id/hinweis" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="vorher 158 € · dazu 15 € · noch nicht gebucht" android:textColor="#DFE6B0" android:textSize="14sp" android:fontFamily="@font/barlow_regular" android:visibility="gone"/>

    <LinearLayout android:id="@+id/schritte" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp"><TextView android:id="@+id/s1" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/knopf" android:gravity="center" android:text="− 5" android:textColor="#EEF2F0" android:textSize="17sp" android:fontFamily="@font/barlow_semibold" android:maxLines="1" android:ellipsize="end" /><TextView android:layout_width="8dp" android:layout_height="1dp"/><TextView android:id="@+id/s2" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/knopf" android:gravity="center" android:text="+ 5" android:textColor="#EEF2F0" android:textSize="17sp" android:fontFamily="@font/barlow_semibold" android:maxLines="1" android:ellipsize="end" /><TextView android:layout_width="8dp" android:layout_height="1dp"/><TextView android:id="@+id/s3" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/knopf" android:gravity="center" android:text="+ 10" android:textColor="#EEF2F0" android:textSize="17sp" android:fontFamily="@font/barlow_semibold" android:maxLines="1" android:ellipsize="end" /></LinearLayout>

    <LinearLayout android:id="@+id/aktion" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp" android:visibility="gone">
        <TextView android:id="@+id/abbrechen" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/knopf_leise" android:gravity="center" android:text="Abbrechen" android:textColor="#B7C1BE" android:textSize="15sp" android:fontFamily="@font/barlow_regular" android:maxLines="1" android:ellipsize="end" /><TextView android:layout_width="8dp" android:layout_height="1dp"/><TextView android:id="@+id/buchen" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="2" android:background="@drawable/knopf_haupt" android:gravity="center" android:text="15 € buchen" android:textColor="#FFFFFF" android:textSize="16sp" android:fontFamily="@font/barlow_semibold" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout android:id="@+id/gebucht" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="10dp" android:visibility="gone">
        <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:src="@drawable/linie" android:scaleType="fitXY" android:contentDescription="@null"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
            <TextView android:id="@+id/gebuchtText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="15 € gebucht. Wo? (optional)" android:textColor="#EEF2F0" android:textSize="14sp" android:fontFamily="@font/barlow_regular" android:maxLines="2"/>
            <TextView android:id="@+id/rueck1" android:layout_width="wrap_content" android:layout_height="36dp" android:background="@drawable/knopf_leise" android:gravity="center" android:paddingLeft="14dp" android:paddingRight="14dp" android:text="Rückgängig" android:textColor="#7FD6C8" android:textSize="14sp" android:fontFamily="@font/barlow_semibold"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp"><TextView android:id="@+id/c1" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:background="@drawable/chip" android:gravity="center" android:text="Edeka" android:textColor="#EEF2F0" android:textSize="14sp" android:fontFamily="@font/barlow_regular" android:maxLines="1" android:ellipsize="end" android:paddingLeft="8dp" android:paddingRight="8dp"/><TextView android:layout_width="6dp" android:layout_height="1dp"/><TextView android:id="@+id/c2" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:background="@drawable/chip" android:gravity="center" android:text="Bäcker" android:textColor="#EEF2F0" android:textSize="14sp" android:fontFamily="@font/barlow_regular" android:maxLines="1" android:ellipsize="end" android:paddingLeft="8dp" android:paddingRight="8dp"/><TextView android:layout_width="6dp" android:layout_height="1dp"/><TextView android:id="@+id/c3" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:background="@drawable/chip" android:gravity="center" android:text="dm" android:textColor="#EEF2F0" android:textSize="14sp" android:fontFamily="@font/barlow_regular" android:maxLines="1" android:ellipsize="end" android:paddingLeft="8dp" android:paddingRight="8dp"/></LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp"><TextView android:id="@+id/c4" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:background="@drawable/chip" android:gravity="center" android:text="Wochenmarkt" android:textColor="#EEF2F0" android:textSize="14sp" android:fontFamily="@font/barlow_regular" android:maxLines="1" android:ellipsize="end" android:paddingLeft="8dp" android:paddingRight="8dp"/><TextView android:layout_width="6dp" android:layout_height="1dp"/><TextView android:id="@+id/c5" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:background="@drawable/chip" android:gravity="center" android:text="Überspringen" android:textColor="#EEF2F0" android:textSize="14sp" android:fontFamily="@font/barlow_regular" android:maxLines="1" android:ellipsize="end" android:paddingLeft="8dp" android:paddingRight="8dp"/><TextView android:layout_width="6dp" android:layout_height="1dp"/><TextView android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/></LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/zuletzt" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="10dp" android:visibility="gone">
        <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:src="@drawable/linie" android:scaleType="fitXY" android:contentDescription="@null"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_haken" android:contentDescription="@null"/>
            <TextView android:id="@+id/zuletztText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginLeft="8dp" android:text="Zuletzt: 15 € · Edeka" android:textColor="#B7C1BE" android:textSize="14sp" android:fontFamily="@font/barlow_regular" android:maxLines="2"/>
            <TextView android:id="@+id/rueck2" android:layout_width="wrap_content" android:layout_height="36dp" android:background="@drawable/knopf_leise" android:gravity="center" android:paddingLeft="14dp" android:paddingRight="14dp" android:text="Rückgängig" android:textColor="#7FD6C8" android:textSize="14sp" android:fontFamily="@font/barlow_semibold"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
